{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/games/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; object-src 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(ar/)?(super-admin|admin|data)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/games/:game/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/games/:game/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "public/{source-release,page-build,library-build}.json"
    }
  },
  "redirects": [
    {
      "source": "/data",
      "destination": "/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/data/",
      "destination": "/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/data/index.html",
      "destination": "/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/ar/data",
      "destination": "/ar/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/ar/data/",
      "destination": "/ar/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/ar/data/index.html",
      "destination": "/ar/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/super-admin/backup/",
      "permanent": false
    },
    {
      "source": "/ar/data/:path*",
      "destination": "/ar/super-admin/backup/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/super-admin",
      "destination": "/api/admin?view=dashboard&lang=en"
    },
    {
      "source": "/super-admin/",
      "destination": "/api/admin?view=dashboard&lang=en"
    },
    {
      "source": "/super-admin/backup",
      "destination": "/api/admin?view=backup&lang=en"
    },
    {
      "source": "/super-admin/backup/",
      "destination": "/api/admin?view=backup&lang=en"
    },
    {
      "source": "/ar/super-admin",
      "destination": "/api/admin?view=dashboard&lang=ar"
    },
    {
      "source": "/ar/super-admin/",
      "destination": "/api/admin?view=dashboard&lang=ar"
    },
    {
      "source": "/ar/super-admin/backup",
      "destination": "/api/admin?view=backup&lang=ar"
    },
    {
      "source": "/ar/super-admin/backup/",
      "destination": "/api/admin?view=backup&lang=ar"
    }
  ]
}
